# Server
PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT (matches Supabase JWT secret)
JWT_SECRET=your-jwt-secret

# Email (Resend)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=noreply@yourschool.com

# App
APP_NAME=School Management Platform
FRONTEND_URL=http://localhost:5173

# Ollama (IA locale)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=mistral

# Chiffrement AES-256-GCM (générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AES_ENCRYPTION_KEY=your-64-char-hex-key
